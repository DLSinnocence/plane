# Docker Compose reads .env automatically from the deployment directory.
# Source checkout: copy this file to .env. Release downloads already use .env.
# Keep .env private and reuse it when upgrading.

APP_RELEASE=preview
DOMAIN_NAME=localhost
WEB_URL=http://localhost:8080
APP_PROTOCOL=http
SITE_ADDRESS=:80
LISTEN_HTTP_PORT=8080
MINIO_ENDPOINT_SSL=0
FILE_SIZE_LIMIT=1073741824
GUNICORN_WORKERS=1

# Internal service endpoints; no public LIVE_BASE_URL is required for AI.
AI_AGENT_URL=http://127.0.0.1:3005/live
API_BASE_URL=http://localhost:3004

# Required: set five independent random values before running docker compose up -d.
# Use 32+ alphanumeric characters (for example, 64 hexadecimal characters).
# Database and message-queue passwords are embedded in connection URLs, so avoid
# URL-special characters. No shared default credentials are provided.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
MINIO_ROOT_PASSWORD=
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=

# Optional MeowAlive (Casdoor OIDC). Existing instances: configure in God mode.
# These values seed configuration when the instance keys are first created.
IS_MEOWALIVE_ENABLED=0
MEOWALIVE_ISSUER_URL=https://sso.meowalive.com
MEOWALIVE_CLIENT_ID=
MEOWALIVE_CLIENT_SECRET=
