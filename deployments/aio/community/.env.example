# Docker Compose reads .env automatically from the deployment directory.
# Source checkout: copy this file to .env. Release downloads already use .env.
# Keep .env private and reuse it when upgrading.

APP_RELEASE=preview
DOMAIN_NAME=localhost
WEB_URL=http://localhost:8080
APP_PROTOCOL=http
SITE_ADDRESS=:80
LISTEN_HTTP_PORT=8080
MINIO_ENDPOINT_SSL=0
FILE_SIZE_LIMIT=5242880
GUNICORN_WORKERS=1

# Required: set five independent random values before running docker compose up -d.
# Use 32+ alphanumeric characters (for example, 64 hexadecimal characters).
# Database and message-queue passwords are embedded in connection URLs, so avoid
# URL-special characters. No shared default credentials are provided.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
MINIO_ROOT_PASSWORD=
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=
